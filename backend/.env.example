# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://pos_user:pos_password@localhost:5432/pos_kasir

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173
SOCKET_IO_CORS=http://localhost:5173

# Logging
LOG_LEVEL=debug

# File Upload
MAX_FILE_SIZE=5242880

# Payment Gateway (Optional)
QRIS_MERCHANT_ID=
QRIS_API_KEY=

# Email (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Cloud Storage (Optional)
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
