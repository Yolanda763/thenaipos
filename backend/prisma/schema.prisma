generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  passwordHash    String
  fullName        String
  role            UserRole  @default(KASIR)
  outlet          Outlet?   @relation(fields: [outletId], references: [id])
  outletId        String?
  isActive        Boolean   @default(true)
  lastLogin       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sales           Sale[]
  activities      ActivityLog[]

  @@index([email])
  @@index([username])
}

enum UserRole {
  ADMIN
  MANAJER
  KASIR
}

// ==================== OUTLET ====================
model Outlet {
  id              String    @id @default(cuid())
  name            String
  address         String
  phone           String
  email           String?
  city            String?
  province        String?
  postalCode      String?
  owner           String?
  licenseNumber   String?
  npwp            String?
  npwpAddress     String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  users           User[]
  sales           Sale[]
  stocks          ProductStock[]
  inventoryLogs   InventoryLog[]
  purchases       Purchase[]

  @@index([name])
}

// ==================== PRODUCT & CATEGORY ====================
model Category {
  id              String    @id @default(cuid())
  name            String    @unique
  description     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  products        Product[]

  @@index([name])
}

model Product {
  id              String    @id @default(cuid())
  barcode         String    @unique
  name            String
  description     String?
  category        Category  @relation(fields: [categoryId], references: [id])
  categoryId      String
  cost            Decimal   @db.Decimal(12, 2)
  price           Decimal   @db.Decimal(12, 2)
  unit            String    @default("pcs")
  image           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  stocks          ProductStock[]
  saleItems       SaleItem[]
  purchaseItems   PurchaseItem[]
  inventoryLogs   InventoryLog[]

  @@index([barcode])
  @@index([name])
  @@index([categoryId])
}

model ProductStock {
  id              String    @id @default(cuid())
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String
  outlet          Outlet    @relation(fields: [outletId], references: [id], onDelete: Cascade)
  outletId        String
  quantity        Int       @default(0)
  minStock        Int       @default(0)
  lastRestockDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([productId, outletId])
  @@index([productId])
  @@index([outletId])
}

// ==================== SALES ====================
model Sale {
  id              String    @id @default(cuid())
  saleNumber      String    @unique
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  outletId        String
  user            User      @relation(fields: [userId], references: [id])
  userId          String
  customer        Customer? @relation(fields: [customerId], references: [id])
  customerId      String?
  items           SaleItem[]
  subtotal        Decimal   @db.Decimal(12, 2)
  discountAmount  Decimal   @db.Decimal(12, 2) @default(0)
  discountType    String?
  discountValue   Decimal   @db.Decimal(12, 2) @default(0)
  tax             Decimal   @db.Decimal(12, 2) @default(0)
  grandTotal      Decimal   @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  status          SaleStatus @default(COMPLETED)
  notes           String?
  payments        Payment[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([outletId])
  @@index([userId])
  @@index([customerId])
  @@index([createdAt])
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURNED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  COMPLETED
  FAILED
}

model SaleItem {
  id              String    @id @default(cuid())
  sale            Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId          String
  product         Product   @relation(fields: [productId], references: [id])
  productId       String
  quantity        Int
  price           Decimal   @db.Decimal(12, 2)
  discountAmount  Decimal   @db.Decimal(12, 2) @default(0)
  subtotal        Decimal   @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())

  @@index([saleId])
  @@index([productId])
}

// ==================== PAYMENT ====================
model Payment {
  id              String    @id @default(cuid())
  sale            Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId          String
  method          PaymentMethod
  amount          Decimal   @db.Decimal(12, 2)
  referenceNumber String?
  notes           String?
  status          PaymentStatus @default(COMPLETED)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([saleId])
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEBIT_CARD
  CREDIT_CARD
  QRIS
  E_WALLET
  CHECK
}

// ==================== CUSTOMER ====================
model Customer {
  id              String    @id @default(cuid())
  name            String
  phone           String    @unique
  email           String?   @unique
  address         String?
  city            String?
  memberSince     DateTime  @default(now())
  totalSpent      Decimal   @db.Decimal(12, 2) @default(0)
  totalTransactions Int     @default(0)
  loyaltyPoints   Int       @default(0)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sales           Sale[]

  @@index([phone])
  @@index([email])
}

// ==================== INVENTORY ====================
model InventoryLog {
  id              String    @id @default(cuid())
  product         Product   @relation(fields: [productId], references: [id])
  productId       String
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  outletId        String
  logType         InventoryLogType
  quantity        Int
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([productId])
  @@index([outletId])
  @@index([createdAt])
}

enum InventoryLogType {
  SALE
  RESTOCK
  RETURN
  ADJUSTMENT
  DAMAGE
  EXPIRE
}

// ==================== PURCHASE ====================
model Supplier {
  id              String    @id @default(cuid())
  name            String    @unique
  phone           String
  email           String?
  address         String?
  city            String?
  npwp            String?
  bankAccount     String?
  contactPerson   String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  purchases       Purchase[]

  @@index([name])
}

model Purchase {
  id              String    @id @default(cuid())
  purchaseNumber  String    @unique
  supplier        Supplier  @relation(fields: [supplierId], references: [id])
  supplierId      String
  outlet          Outlet    @relation(fields: [outletId], references: [id])
  outletId        String
  items           PurchaseItem[]
  subtotal        Decimal   @db.Decimal(12, 2)
  tax             Decimal   @db.Decimal(12, 2) @default(0)
  discount        Decimal   @db.Decimal(12, 2) @default(0)
  grandTotal      Decimal   @db.Decimal(12, 2)
  status          PurchaseStatus @default(PENDING)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([supplierId])
  @@index([outletId])
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

model PurchaseItem {
  id              String    @id @default(cuid())
  purchase        Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId      String
  product         Product   @relation(fields: [productId], references: [id])
  productId       String
  quantity        Int
  cost            Decimal   @db.Decimal(12, 2)
  subtotal        Decimal   @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())

  @@index([purchaseId])
  @@index([productId])
}

// ==================== DISCOUNT ====================
model Discount {
  id              String    @id @default(cuid())
  name            String
  description     String?
  type            DiscountType
  value           Decimal   @db.Decimal(12, 2)
  minPurchase     Decimal   @db.Decimal(12, 2) @default(0)
  maxDiscount     Decimal   @db.Decimal(12, 2)?
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([name])
}

enum DiscountType {
  PERCENTAGE
  NOMINAL
}

// ==================== TAX ====================
model Tax {
  id              String    @id @default(cuid())
  name            String    @unique
  percentage      Decimal   @db.Decimal(5, 2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ==================== ACTIVITY LOG ====================
model ActivityLog {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id])
  userId          String
  action          String
  description     String?
  metadata        String?
  ipAddress       String?
  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}
